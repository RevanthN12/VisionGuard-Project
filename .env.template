# ==========================================
# Vision Guard - External Alert Credentials
# ==========================================

# 1. GMAIL CONFIGURATION
# ------------------------------------------
# To send emails, you must use a Gmail App Password (not your normal password).
# Instructions: Go to Google Account -> Security -> 2-Step Verification -> App passwords.
GMAIL_SENDER_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password

# The email address that will receive the alert (can be the same as sender)
ALERT_RECIPIENT_EMAIL=recipient_email@example.com

# 2. WHATSAPP CONFIGURATION
# ------------------------------------------
# Target phone number MUST include the country code (e.g., +91 for India, +1 for US)
# Example: +919876543210
WHATSAPP_TARGET_NUMBER=+91xxxxxxxxxx

# IMPORTANT NOTE FOR WHATSAPP: 
# The script uses pywhatkit which will open your default web browser to WhatsApp Web.
# You MUST be logged into WhatsApp Web on your default browser for this to work.
