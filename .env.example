# VisionGuard Environment Configuration Example

FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Cloud Video Evidence Storage Configuration
VIDEO_STORAGE_PROVIDER=cloudinary
VIDEO_STORAGE_BUCKET=visionguard_evidence
VIDEO_STORAGE_URL=https://res.cloudinary.com/demo/video/upload/
VIDEO_STORAGE_API_KEY=YOUR_API_KEY
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Alert Notifications (Telegram / Gmail SMTP)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
GMAIL_SENDER_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password
ALERT_RECIPIENT_EMAIL=recipient@gmail.com
